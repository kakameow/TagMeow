<?xml version="1.0" encoding="utf-8"?>
<!-- 目录管理列表里的一行：选择框 + 图标 + 名称/路径 + 有效标记 + 更多 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dirManageRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="58dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/dirSelect"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:gravity="center"
        android:textColor="#ffffff"
        android:textSize="12sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/dirManageIcon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="10dp"
        android:contentDescription="@null"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/folder" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/dirManageName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#20242b"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dirManagePath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textColor="#8c939f"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/dirBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:paddingStart="6dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp"
        android:textSize="9sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/dirManageMore"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginStart="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:text="⋮"
        android:textColor="#9aa1ab"
        android:textSize="17sp" />
</LinearLayout>
