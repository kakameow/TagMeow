    "text": [
        {
            "id": "help.all",
            "str": "\n可用命令: \n  help --显示帮助\n  exit --退出程序\n  language --语言管理\n  root --根目录管理\n  tag --标签管理\n  file --文件管理\n  search --搜索文件\n  server --同步服务器\n  client --同步客户端\n"
        },
        {
            "id": "help.tip",
            "str": "\n未知命令，输入 help 查看帮助\n"
        },
        {
            "id": "help.language.all",
            "str": "\n语言管理命令:\n  language list --列出所有可用语言\n  language reload --重新加载语言文件\n  language change <语言名> --切换语言\n"
        },
        {
            "id": "help.language.change",
            "str": "\n用法: language change <语言名> --切换语言\n"
        },
        {
            "id": "help.language.reload",
            "str": "\n用法: language reload --重新加载语言文件\n"
        },
