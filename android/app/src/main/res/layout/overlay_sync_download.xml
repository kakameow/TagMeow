<?xml version="1.0" encoding="utf-8"?>
<!-- 同步子界面二：从其他设备下载（对应 Windows 端 syncWindow 的 rect3） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/syncDownloadOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f5f6f8"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="#ffffff"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/btnSyncDownloadBack"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="返回"
            android:textColor="#59616e"
            android:textSize="13sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvSyncDownloadTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="从其他设备下载"
            android:textColor="#20242b"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="50dp"
            android:layout_height="1dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#e2e6ee" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/tvSyncPathLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="保存到"
                android:textColor="#8c939f"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvSyncDownloadPath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#ffffff"
                android:ellipsize="middle"
                android:maxLines="2"
                android:paddingStart="10dp"
                android:paddingTop="9dp"
                android:paddingEnd="10dp"
                android:paddingBottom="9dp"
                android:text="/storage/emulated/0/TagMeow/download"
                android:textColor="#20242b"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnSyncPathChange"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_mini"
                    android:gravity="center"
                    android:text="更改保存目录"
                    android:textColor="#20242b"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnSyncPathAsRoot"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_mini_primary"
                    android:gravity="center"
                    android:text="加入管理目录"
                    android:textColor="#ffffff"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSyncDeviceTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="局域网设备"
                android:textColor="#8c939f"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/syncDeviceList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#ffffff"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvSyncDeviceEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="22dp"
                android:text="还没有扫描到设备"
                android:textColor="#8c939f"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvSyncRecordHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="下载记录：已经成功下载过的文件会被跳过；清除记录后下次会全部重下（不会删除已下载的文件）"
                android:textColor="#8c939f"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/tvSyncClientProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#ffffff"
        android:gravity="center"
        android:maxLines="1"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:textColor="#59616e"
        android:textSize="11sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvSyncClientStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#ffffff"
        android:ellipsize="middle"
        android:gravity="center"
        android:maxLines="2"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:text=""
        android:textColor="#8c939f"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#ffffff"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/btnSyncScan"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_mini_primary"
            android:gravity="center"
            android:text="搜索设备"
            android:textColor="#ffffff"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnSyncDownloadSel"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_mini"
            android:gravity="center"
            android:text="下载选中"
            android:textColor="#20242b"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnSyncClearRecords"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_mini"
            android:gravity="center"
            android:text="清除记录"
            android:textColor="#20242b"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnSyncClientDisconnect"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_danger"
            android:gravity="center"
            android:text="断开"
            android:textColor="#df6876"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
