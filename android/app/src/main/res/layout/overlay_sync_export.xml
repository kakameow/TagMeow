<?xml version="1.0" encoding="utf-8"?>
<!-- 同步子界面三：其他方式分享（选目录 -> 压成 zip -> 交给系统分享面板） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/syncExportOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f5f6f8"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="#ffffff"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/btnSyncExportBack"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="返回"
            android:textColor="#59616e"
            android:textSize="13sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvSyncExportTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="其他方式分享"
            android:textColor="#20242b"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="50dp"
            android:layout_height="1dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#e2e6ee" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/tvSyncExportZipDirLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="压缩包目录"
                android:textColor="#8c939f"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvSyncExportZipDir"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#ffffff"
                android:ellipsize="middle"
                android:maxLines="2"
                android:paddingStart="10dp"
                android:paddingTop="9dp"
                android:paddingEnd="10dp"
                android:paddingBottom="9dp"
                android:textColor="#20242b"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvSyncExportDirLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="要分享的目录"
                android:textColor="#8c939f"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvSyncExportDir"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#ffffff"
                android:ellipsize="middle"
                android:maxLines="2"
                android:paddingStart="10dp"
                android:paddingTop="9dp"
                android:paddingEnd="10dp"
                android:paddingBottom="9dp"
                android:textColor="#20242b"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnSyncExportBrowse"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_mini"
                    android:gravity="center"
                    android:text="选择目录"
                    android:textColor="#20242b"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnSyncExportStart"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_mini_primary"
                    android:gravity="center"
                    android:text="压缩并分享"
                    android:textColor="#ffffff"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnSyncExportDelete"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_danger"
                android:gravity="center"
                android:text="删除全部压缩包"
                android:textColor="#df6876"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvSyncExportHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="压缩包只放在应用内部目录里，分享完可以一键全部删掉"
                android:textColor="#8c939f"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/tvSyncExportProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#ffffff"
        android:gravity="center"
        android:maxLines="1"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:textColor="#59616e"
        android:textSize="11sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvSyncExportStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#ffffff"
        android:ellipsize="middle"
        android:gravity="center"
        android:maxLines="2"
        android:minHeight="34dp"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:text=""
        android:textColor="#8c939f"
        android:textSize="11sp" />
</LinearLayout>
